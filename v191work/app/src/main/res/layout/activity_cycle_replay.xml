<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/light_bg">

    <TextView
        android:id="@+id/txtReplayTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy"
        android:padding="12dp"
        android:text="A 정상 Cycle ↔ B 문제 Cycle 반복 비교"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtReplayInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/panel"
        android:padding="10dp"
        android:text="Cycle 정보"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="4dp">
            <TextView android:id="@+id/txtReplayA" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="A 기준" android:textStyle="bold" />
            <VideoView android:id="@+id/videoReplayA" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#000000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">
            <TextView android:id="@+id/txtReplayB" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="B 비교" android:textStyle="bold" />
            <VideoView android:id="@+id/videoReplayB" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#000000" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/txtReplayProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Cycle 진행률 · A 0% | B 0% | Δ 0%"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A 기준 Cycle 진행률"
        android:textSize="11sp" />
    <ProgressBar
        android:id="@+id/progressReplayA"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="1000"
        android:progress="0" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="B 문제 Cycle 진행률"
        android:textSize="11sp" />
    <ProgressBar
        android:id="@+id/progressReplayB"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="1000"
        android:progress="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button android:id="@+id/btnReplayRestart" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="↻ 동시 다시 시작" />
        <Button android:id="@+id/btnReplayPause" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⏸ 일시정지" />
        <Button android:id="@+id/btnReplaySync" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⇄ 진행률 동기화" />
        <Button android:id="@+id/btnReplayClose" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="닫기" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtReplayModeNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="※ 원속도 모드: 실제 Cycle Time 차이를 그대로 봅니다. 진행률 동기화 모드: 짧은 Cycle을 느리게 재생해 A/B의 0~100% 동작 위치를 맞춰 비교합니다."
        android:textSize="11sp" />
</LinearLayout>
