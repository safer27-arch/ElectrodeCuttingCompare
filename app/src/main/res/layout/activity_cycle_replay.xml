<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/light_bg"
    android:fitsSystemWindows="true">

    <com.example.electrodecutcompare.LocalizedTextView
        android:id="@+id/txtReplayTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_panel"
        android:padding="12dp"
        android:text="TOP1 · 문제 Cycle 비교"
        android:textColor="#FFFFFF"
        android:textSize="23sp"
        android:textStyle="bold" />

    <com.example.electrodecutcompare.LocalizedTextView
        android:id="@+id/txtReplayInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/panel_info"
        android:padding="10dp"
        android:text="Cycle 정보"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textStyle="bold" />

    <com.example.electrodecutcompare.LocalizedTextView
        android:id="@+id/txtProblemAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/panel_warning"
        android:gravity="center"
        android:padding="8dp"
        android:text="⚠ 문제구간 45~55% · 커팅/충격"
        android:textColor="#FFF0A8"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="4dp">
            <com.example.electrodecutcompare.LocalizedTextView android:id="@+id/txtReplayA" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="A 기준 · 정상 Cycle" android:textColor="@color/cyan" android:textSize="17sp" android:textStyle="bold" />
            <TextureView android:id="@+id/videoReplayA" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#000000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">
            <com.example.electrodecutcompare.LocalizedTextView android:id="@+id/txtReplayB" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="B 비교 · 문제 Cycle" android:textColor="@color/warning" android:textSize="17sp" android:textStyle="bold" />
            <TextureView android:id="@+id/videoReplayB" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#000000" />
        </LinearLayout>
    </LinearLayout>

    <com.example.electrodecutcompare.LocalizedTextView
        android:id="@+id/txtReplayProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:text="Cycle 진행률 · A 0% | B 0% | Δ 0%"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.example.electrodecutcompare.CycleProgressView
        android:id="@+id/cycleProgressView"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">
        <com.example.electrodecutcompare.LocalizedButton android:id="@+id/btnReplayRestart" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="50dp" android:text="↻ 전체 다시" />
        <com.example.electrodecutcompare.LocalizedButton android:id="@+id/btnReplayPause" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="50dp" android:text="⏸ 일시정지" />
        <com.example.electrodecutcompare.LocalizedButton android:id="@+id/btnReplaySync" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="50dp" android:text="✓ 동기화 ON" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <com.example.electrodecutcompare.LocalizedButton android:id="@+id/btnProblemLoop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:minHeight="52dp" android:background="@drawable/button_primary" android:textColor="#FFFFFF" android:textStyle="bold" android:text="⚠ 문제구간만 반복" />
        <com.example.electrodecutcompare.LocalizedButton android:id="@+id/btnReplayClose" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp" android:text="닫기" />
    </LinearLayout>

    <com.example.electrodecutcompare.LocalizedTextView
        android:id="@+id/txtReplayModeNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="노란 구간 = 문제 동작구간 · 동기화 ON = A/B의 같은 0~100% 위치를 맞춰 비교"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
</LinearLayout>
