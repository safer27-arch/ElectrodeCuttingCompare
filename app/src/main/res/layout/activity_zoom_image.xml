<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#111111">
 <ImageView android:id="@+id/zoomImage" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#111111"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:padding="12dp" android:background="#AA000000">
  <Button android:id="@+id/zoomReset" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="원위치"/>
  <Button android:id="@+id/zoomClose" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="닫기"/>
 </LinearLayout>
</FrameLayout>