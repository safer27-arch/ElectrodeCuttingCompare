<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/light_bg" android:fitsSystemWindows="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="14dp">
    <com.example.electrodecutcompare.LocalizedTextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/navy" android:padding="16dp" android:text="v0.4 ROI 설정"
        android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold"/>
    <Spinner android:id="@+id/machineSpinner" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Spinner android:id="@+id/roiSpinner" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <com.example.electrodecutcompare.LocalizedTextView android:id="@+id/roiInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" android:text="ROI 선택" android:textStyle="bold"/>
    <ImageView android:id="@+id/roiImage" android:layout_width="match_parent" android:layout_height="250dp"
        android:background="#E8EDF2" android:scaleType="fitCenter"/>
    <com.example.electrodecutcompare.LocalizedTextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="10dp" android:text="위치 이동" android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <com.example.electrodecutcompare.LocalizedButton android:id="@+id/left" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="←"/>
      <com.example.electrodecutcompare.LocalizedButton android:id="@+id/up" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="↑"/>
      <com.example.electrodecutcompare.LocalizedButton android:id="@+id/down" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="↓"/>
      <com.example.electrodecutcompare.LocalizedButton android:id="@+id/right" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="→"/>
    </LinearLayout>
    <com.example.electrodecutcompare.LocalizedTextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="8dp" android:text="크기 조절" android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <com.example.electrodecutcompare.LocalizedButton android:id="@+id/wminus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="폭 −"/>
      <com.example.electrodecutcompare.LocalizedButton android:id="@+id/wplus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="폭 +"/>
      <com.example.electrodecutcompare.LocalizedButton android:id="@+id/hminus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="높이 −"/>
      <com.example.electrodecutcompare.LocalizedButton android:id="@+id/hplus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="높이 +"/>
    </LinearLayout>
    <com.example.electrodecutcompare.LocalizedButton android:id="@+id/saveRoi" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="현재 ROI 저장" android:textStyle="bold"/>
    <com.example.electrodecutcompare.LocalizedButton android:id="@+id/resetRoi" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="선택 설비 ROI 전체 초기화"/>
    <com.example.electrodecutcompare.LocalizedTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp"
        android:text="초록=Gripper / 주황=전극 선단 / 빨강=Nip\n설비 A/B 설정은 각각 별도로 휴대폰에 저장됩니다."/>
  </LinearLayout>
</ScrollView>